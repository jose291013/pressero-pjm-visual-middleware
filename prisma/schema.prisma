generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NegotiatedPriceProfileMode {
  single
  multi
}

enum NegotiatedPriceVisibilityMode {
  hidden
  selectable
}

enum PresseroPricingMode {
  pjmLive
  negotiated
}

model PjmProductCategory {
  id               String               @id @default(cuid())
  pjmId            String               @unique
  name             String
  slug             String?
  parentId         String?
  parent           PjmProductCategory?  @relation("PjmCategoryTree", fields: [parentId], references: [id])
  children         PjmProductCategory[] @relation("PjmCategoryTree")
  priceEngines     PjmPriceEngine[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model PjmPriceGroup {
  id             String                       @id @default(cuid())
  pjmId          String                       @unique
  name           String
  description    String?
  engineMappings PjmEnginePriceGroupMapping[]
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
}

model PjmOrganization {
  id        String   @id @default(cuid())
  pjmId     String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([isActive])
}

model PjmPriceEngine {
  id                 String                       @id @default(cuid())
  pjmId              String                       @unique
  name               String
  description        String?
  isActive           Boolean                      @default(true)
  productCategoryId  String?
  productCategory    PjmProductCategory?          @relation(fields: [productCategoryId], references: [id])
  priceGroupMappings PjmEnginePriceGroupMapping[]
  options            PjmOption[]
  negotiatedProfiles NegotiatedPriceProfile[]
  presseroConfigs    PresseroProductConfig[]
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
}

model PjmEnginePriceGroupMapping {
  id                            String         @id @default(cuid())
  enginePriceGroupIntegrationId String         @unique
  priceEngineId                 String
  priceGroupId                  String
  priceEngine                   PjmPriceEngine @relation(fields: [priceEngineId], references: [id], onDelete: Cascade)
  priceGroup                    PjmPriceGroup  @relation(fields: [priceGroupId], references: [id], onDelete: Cascade)
  createdAt                     DateTime       @default(now())
  updatedAt                     DateTime       @updatedAt

  @@index([priceEngineId])
  @@index([priceGroupId])
}

model PjmOption {
  id            String            @id @default(cuid())
  pjmId         String            @unique
  priceEngineId String
  name          String
  displayName   String?
  optionType    String?
  sortOrder     Int               @default(0)
  isVisual      Boolean           @default(false)
  priceEngine   PjmPriceEngine    @relation(fields: [priceEngineId], references: [id], onDelete: Cascade)
  choices       PjmOptionChoice[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([priceEngineId])
}

model PjmOptionChoice {
  id             String                @id @default(cuid())
  pjmId          String                @unique
  optionId       String
  name           String
  value          String
  normalizedName String?
  sortOrder      Int                   @default(0)
  isActive       Boolean               @default(true)
  option         PjmOption             @relation(fields: [optionId], references: [id], onDelete: Cascade)
  visualMapping  VisualOptionMapping?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([optionId])
}

model MediaAsset {
  id             String                @id @default(cuid())
  key            String                @unique
  fileName       String
  mimeType       String
  url            String
  altText        String?
  width          Int?
  height         Int?
  byteSize       Int?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  visualMappings VisualOptionMapping[]
}

model VisualOptionMapping {
  id             String          @id @default(cuid())
  optionChoiceId String          @unique
  mediaAssetId   String
  displayOrder   Int             @default(0)
  isEnabled      Boolean         @default(true)
  optionChoice   PjmOptionChoice @relation(fields: [optionChoiceId], references: [id], onDelete: Cascade)
  mediaAsset     MediaAsset      @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([mediaAssetId])
}

model NegotiatedPriceProfile {
  id                            String                         @id @default(cuid())
  clientId                      String
  organizationIntegrationId     String?
  misId                         String?
  name                          String
  priceEngineId                 String?
  enginePriceGroupIntegrationId String?
  priceGroupName                String?
  profileMode                   NegotiatedPriceProfileMode      @default(single)
  visibilityMode                NegotiatedPriceVisibilityMode   @default(hidden)
  isActive                      Boolean                        @default(true)
  priceEngine                   PjmPriceEngine?                @relation(fields: [priceEngineId], references: [id])
  combinations                  NegotiatedPriceCombination[]
  combinationSets               NegotiatedPriceCombinationSet[]
  importJobs                    NegotiatedPriceImportJob[]
  presseroConfigs               PresseroProductConfig[]
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt

  @@index([clientId])
  @@index([organizationIntegrationId])
  @@index([misId])
  @@index([priceEngineId])
  @@index([organizationIntegrationId, priceEngineId, misId])
}

model PresseroProductConfig {
  id                            String                  @id @default(cuid())
  misProductId                  String                  @unique
  name                          String
  pricingMode                   PresseroPricingMode     @default(pjmLive)
  organizationIntegrationId     String
  organizationName              String?
  priceEngineId                 String
  enginePriceGroupIntegrationId String
  priceGroupName                String?
  negotiatedProfileId           String?
  notes                         String?
  isActive                      Boolean                 @default(true)
  priceEngine                   PjmPriceEngine          @relation(fields: [priceEngineId], references: [id])
  negotiatedProfile             NegotiatedPriceProfile? @relation(fields: [negotiatedProfileId], references: [id])
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt

  @@index([organizationIntegrationId])
  @@index([priceEngineId])
  @@index([enginePriceGroupIntegrationId])
  @@index([negotiatedProfileId])
  @@index([pricingMode])
}

model NegotiatedPriceCombination {
  id                   String                 @id @default(cuid())
  profileId            String
  combinationKey        String
  label                String?
  optionSelections     Json
  pricingBasisSnapshot Json
  fixedParameters      Json?
  clientVariables      Json?
  isDefault            Boolean                @default(false)
  sortOrder            Int                    @default(0)
  status               String                 @default("active")
  profile              NegotiatedPriceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tiers                NegotiatedPriceTier[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([profileId])
  @@index([status])
  @@unique([profileId, combinationKey])
}

model NegotiatedPriceTier {
  id              String                     @id @default(cuid())
  combinationId   String
  tierValue       Decimal                    @db.Decimal(12, 4)
  tierLabel       String?
  pjmPrice        Decimal?                   @db.Decimal(12, 4)
  negotiatedPrice Decimal?                   @db.Decimal(12, 4)
  currency        String                     @default("EUR")
  combination     NegotiatedPriceCombination @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  @@index([combinationId])
  @@unique([combinationId, tierValue])
}

model NegotiatedPriceCombinationSet {
  id                    String                 @id @default(cuid())
  profileId             String
  quantity              Int
  pages                 Int?
  optionChoiceSignature String
  combinationHash       String                 @unique
  pjmPrice              Decimal?               @db.Decimal(12, 4)
  negotiatedPrice       Decimal?               @db.Decimal(12, 4)
  currency              String                 @default("EUR")
  profile               NegotiatedPriceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([profileId])
  @@index([quantity])
}

model NegotiatedPriceImportJob {
  id             String                 @id @default(cuid())
  profileId      String
  fileName       String
  status         String                 @default("pending")
  rowCount       Int                    @default(0)
  errorMessage   String?
  profile        NegotiatedPriceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  completedAt    DateTime?

  @@index([profileId])
  @@index([status])
}
