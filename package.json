{
  "name": "pressero-pjm-visual-middleware",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Middleware foundation between Pressero and PrintJobManager/PJM for lightweight visual product configuration.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test:sprint1": "node scripts/test-sprint-1-foundation.mjs",
    "test:sprint2": "node scripts/test-sprint-2-pjm-sync-foundation.mjs",
    "test:sprint3": "node scripts/test-sprint-3-pjm-contracts.mjs",
    "test:sprint4": "node scripts/test-sprint-4-pjm-client.mjs",
    "dev:check": "node scripts/dev-check.mjs",
    "seed:pjm-mock": "node scripts/seed-pjm-mock.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "express": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
